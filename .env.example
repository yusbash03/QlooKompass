# ─────────────────────────────────────────────────────────────
# Kulture Compass — environment variables (PLACEHOLDERS ONLY)
# Copy to .env for docker compose. Never commit a filled .env.
# docker-compose.yml maps each variable to the .NET setting in brackets (Section__Key). Running the API outside
# compose? Use user-secrets for keys (dotnet user-secrets set "Qloo:ApiKey" ...) instead of this file.
# ─────────────────────────────────────────────────────────────

# ── Backend: core ──
ASPNETCORE_ENVIRONMENT=Development
APP_BASE_URL=http://localhost:5173                  # [App__BaseUrl]  frontend origin, used for CORS
APP_TRUST_FORWARDED_HEADERS=false                   # [App__TrustForwardedHeaders] true only when reachable solely via a trusted proxy
APP_ENFORCE_HTTPS=true                              # [App__EnforceHttps] outside Development: redirect HTTP->HTTPS (needs ASPNETCORE_HTTPS_PORT)
POSTGRES_PASSWORD=change-me                         # compose: db password; compose builds ConnectionStrings__Default (Host=db) from it
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=kulture_compass;Username=kc;Password=change-me   # [ConnectionStrings__Default] outside compose only

# ── Qloo (backend only) ──
QLOO_BASE_URL=https://hackathon.api.qloo.com        # [Qloo__BaseUrl]
QLOO_API_KEY=replace-me                             # [Qloo__ApiKey]   NEVER commit a real key
QLOO_MODE=Live                                      # [Qloo__Mode]     Live | Mock
QLOO_TIMEOUT_SECONDS=20                             # [Qloo__TimeoutSeconds]
QLOO_MAX_REQUESTS_PER_SECOND=4                      # [Qloo__MaxRequestsPerSecond] hackathon key observed at 5 rps
QLOO_MAX_CALLS_PER_PLAN=12                          # [Qloo__MaxCallsPerPlan]
QLOO_CACHE_TTL_MINUTES=0                            # [Qloo__CacheTtlMinutes] 0 = disabled; private server-side caching is allowed by the hackathon terms
QLOO_LOCATION_INSIGHTS_VERIFIED=true                # [Qloo__LocationInsightsVerified] confirmed by BE-0 live probe
QLOO_PERSON_INSIGHTS_VERIFIED=true                  # [Qloo__PersonInsightsVerified]   confirmed by BE-0 live probe
QLOO_DEMOGRAPHICS_VERIFIED=false                    # [Qloo__DemographicsVerified]     endpoint responds but shape needs dedicated handling (not entity-shaped)

# ── LLM (backend only) ──
LLM_PROVIDER=Mock                                   # [Llm__Provider]  Mock | Gemini | OpenAiCompatible
LLM_API_KEY=replace-me                              # [Llm__ApiKey]
LLM_MODEL=gemini-flash-lite-latest                  # [Llm__Model]     verified live 2026-10-25 (resolves to gemini-3.5-flash-lite)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta   # [Llm__BaseUrl] (OpenAiCompatible: e.g. https://api.groq.com/openai/v1)
LLM_TIMEOUT_SECONDS=60                              # [Llm__TimeoutSeconds]
LLM_MAX_OUTPUT_TOKENS=6000                          # [Llm__MaxOutputTokens]
LLM_MAX_REPAIR_ATTEMPTS=2                           # [Llm__MaxRepairAttempts]
LLM_MAX_RETRY_DELAY_SECONDS=20                      # [Llm__MaxRetryDelaySeconds] cap on provider-requested 429 retry delay
LLM_MOCK_SCENARIO=Valid                             # [Llm__MockScenario] Mock only: Valid | InvalidJsonOnce | UnknownEvidenceKey | Truncated | QuotaExceeded

# ── JWT auth (backend issues + validates tokens) ──
JWT_ISSUER=https://localhost:8080                   # [Jwt__Issuer]
JWT_AUDIENCE=kulture-compass-web                    # [Jwt__Audience]
JWT_SIGNING_KEY=replace-with-openssl-rand-base64-48 # [Jwt__SigningKey]  ≥ 32 random bytes, base64. NEVER commit a real key
JWT_ACCESS_TOKEN_MINUTES=15                         # [Jwt__AccessTokenMinutes]
JWT_REFRESH_TOKEN_DAYS=14                           # [Jwt__RefreshTokenDays]  sliding
JWT_REFRESH_TOKEN_ABSOLUTE_DAYS=30                  # [Jwt__RefreshTokenAbsoluteDays]
AUTH_COOKIE_SECURE=true                             # [Jwt__CookieSecure] false only for plain-http local dev (compose default when unset: false)
DEMO_USER_EMAIL=                                    # [Demo__UserEmail]    optional: seeds a judge account in non-Production
DEMO_USER_PASSWORD=                                 # [Demo__UserPassword] optional (must meet password policy)
RATE_LIMIT_AUTH_PER_MINUTE=10                       # [RateLimiting__AuthPerMinute]        /auth/register + /auth/login, per IP
RATE_LIMIT_AUTH_REFRESH_PER_MINUTE=30               # [RateLimiting__AuthRefreshPerMinute] /auth/refresh, per IP
RATE_LIMIT_GLOBAL_PER_MINUTE=120                    # [RateLimiting__GlobalPerMinute]      all endpoints except health, per user (else IP)
RATE_LIMIT_GENERATION_PER_MINUTE=3                  # [RateLimiting__GenerationPerMinute]  POST /growth-plans, /evaluations, per user
RATE_LIMIT_PUBLIC_PER_MINUTE=30                     # [RateLimiting__PublicPerMinute]      /meta, /sample-plan, per IP

# ── Feature flags ──
FEATURE_EVALUATION_MODE=true                        # [Features__EvaluationMode] dev/judges only
FEATURE_SAMPLE_PLAN=true                            # [Features__SamplePlan] public, synthetic sample plan
GENERATION_DAILY_LIMIT_PER_USER=10                  # [Generation__DailyLimitPerUser]
GENERATION_TIMEOUT_SECONDS=180                      # [Generation__TimeoutSeconds]   overall per-plan timeout
GENERATION_WORKER_CONCURRENCY=2                     # [Generation__WorkerConcurrency] plans generated in parallel

# ── Frontend (PUBLIC values only — everything VITE_* is shipped to browsers) ──
VITE_API_BASE_URL=                                  # empty = same-origin relative /api (Vite proxy in dev). Needed for the refresh cookie.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080    # dev server only
VITE_APP_NAME=Kulture Compass
VITE_ENABLE_EVALUATION=true
