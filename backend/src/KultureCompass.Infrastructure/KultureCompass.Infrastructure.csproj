<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KultureCompass.Application\KultureCompass.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- EF Core migration codegen under Persistence/Migrations triggers CA1861 (array literal args); it is
         generated code we don't hand-edit, so the rule is suppressed project-wide rather than hand-patched
         after every `dotnet ef migrations add`. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MockQlooClient serves these at runtime; the same files are referenced by Infrastructure.Tests so there is
         exactly one copy of every synthetic fixture on disk. -->
    <EmbeddedResource Include="..\..\tests\Fixtures\qloo\*.json">
      <LogicalName>Qloo.Fixtures.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KultureCompass.Infrastructure.Tests" />
  </ItemGroup>

</Project>
