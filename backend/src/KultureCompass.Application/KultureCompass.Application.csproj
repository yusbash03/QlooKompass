<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KultureCompass.Domain\KultureCompass.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Result-union types (QlooResult<T>, LlmResult, etc.) intentionally expose Ok/Fail factories on the
         generic type itself for call-site ergonomics (QlooResult<T>.Fail(...)); CA1000 disagrees. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
  </PropertyGroup>

</Project>
