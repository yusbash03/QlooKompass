<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KultureCompass.Domain\KultureCompass.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- BE-04 §3: versioned prompts + response schemas. The synthesis schema is linked from contracts/ so the LLM,
         the validator and the frontend all share one file. -->
    <EmbeddedResource Include="Generation\Prompts\*.md" LogicalName="Prompts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Generation\Schemas\*.json" LogicalName="Schemas.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\growth-plan-llm-output.schema.json" LogicalName="Schemas.growth-plan-llm-output.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KultureCompass.Application.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Result-union types (QlooResult<T>, LlmResult, etc.) intentionally expose Ok/Fail factories on the
         generic type itself for call-site ergonomics (QlooResult<T>.Fail(...)); CA1000 disagrees. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
  </PropertyGroup>

</Project>
